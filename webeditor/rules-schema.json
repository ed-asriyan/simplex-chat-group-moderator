{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Moderation Rules",
    "description": "**1️⃣ Pick a rule in the list, or add a new one. 2️⃣ For each rule set the 🔎 Condition — what to detect — and the ⚡ Actions — what the bot does when a message matches. 3️⃣ When you're done, press \"Apply changes\" and send the copied link back to the bot.**",
    "definitions": {
        "action": {
            "type": "object",
            "title": "⚡ Action",
            "description": "One thing the bot does when a message matches this rule.",
            "options": {
                "disable_collapse": true
            },
            "oneOf": [
                {
                    "type": "object",
                    "title": "🗑 Moderate the message",
                    "description": "Marks the message as moderated. The bot must have the **Moderator or higher** role in the group to perform this action.",
                    "required": [
                        "type"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ModerateMessage",
                            "default": "ModerateMessage",
                            "options": {
                                "hidden": true
                            }
                        }
                    },
                    "options": {
                        "execution_rank": 2,
                        "phrase": "moderate"
                    }
                },
                {
                    "type": "object",
                    "title": "👁 Set author as observer",
                    "description": "Sets the author to the observer role, so they can read the group but not write to it. The bot must have the **Admin or higher** role in the group to perform this action. _The message that triggered the rule stays in the group — add the 🗑 *Moderate the message* action next to this one if it should be removed too._",
                    "required": [
                        "type",
                        "duration_minutes"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "SetAuthorObserver",
                            "default": "SetAuthorObserver",
                            "options": {
                                "hidden": true
                            }
                        },
                        "duration_minutes": {
                            "type": "integer",
                            "title": "Restore the author to member after this many minutes",
                            "default": 0,
                            "minimum": 0,
                            "maximum": 43200,
                            "description": "0 keeps the author an observer until you change their role by hand. The maximum is 43200 minutes (30 days).",
                            "options": {
                                "label": "Restore author to member after (minutes)"
                            }
                        }
                    },
                    "options": {
                        "execution_rank": 1,
                        "covered_by": [
                            "KickAuthor"
                        ],
                        "summary": "{duration_minutes?$ min:indefinitely}",
                        "phrase": "observer"
                    }
                },
                {
                    "type": "object",
                    "title": "🚪 Kick the author",
                    "description": "Kicks the author from the group. The bot must have the **Owner** role in the group to perform this action. _The message that triggered the rule stays in the group — add the 🗑 *Moderate the message* action next to this one if it should be removed too._",
                    "required": [
                        "type",
                        "delete_all_messages"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "KickAuthor",
                            "default": "KickAuthor",
                            "options": {
                                "hidden": true
                            }
                        },
                        "delete_all_messages": {
                            "type": "boolean",
                            "title": "Also delete every message the author has ever sent in this group",
                            "format": "checkbox",
                            "default": false,
                            "description": "Deletes the author's whole history in this group, not just the message that triggered the rule."
                        }
                    },
                    "options": {
                        "execution_rank": 3,
                        "summary": "{delete_all_messages?+ delete history:}",
                        "phrase": "kick"
                    }
                }
            ]
        },
        "condition": {
            "type": "object",
            "title": "🔎 Condition",
            "description": "What the bot looks for in a message.",
            "options": {
                "disable_collapse": true,
                "max_depth": 8,
                "max_nodes": 64
            },
            "oneOf": [
                {
                    "type": "object",
                    "title": "💬 Message Contains Any of These Words",
                    "description": "Matches when the message contains any of the listed words or phrases. It automatically catches different capitalizations and common tricks used to obfuscate words (like writing `b@dw0rd` instead of `badword`). _Ready-to-use lists of profanity: [🔞 List of Dirty, Naughty, Obscene Words](https://github.com/LDNOOBW/List-of-Dirty-Naughty-Obscene-and-Otherwise-Bad-Words), [☕ Google Profanity Words](https://github.com/coffee-and-fun/google-profanity-words/tree/main/data), [💬 Comment Blocklist](https://github.com/splorp/wordpress-comment-blocklist)_",
                    "required": [
                        "type",
                        "keywords"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ContainsWords",
                            "default": "ContainsWords",
                            "options": {
                                "hidden": true
                            }
                        },
                        "keywords": {
                            "type": "array",
                            "title": "Words / Phrases",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Word/Phrase",
                                "maxLength": 100
                            },
                            "maxItems": 10000
                        }
                    },
                    "options": {
                        "summary": "{keywords|list}",
                        "phrase": "contains one of {keywords|n} words"
                    }
                },
                {
                    "type": "object",
                    "title": "💬 Message Exactly Matches Any of These Texts",
                    "description": "Matches when the whole message text is exactly one of the listed texts (leading and trailing spaces are ignored).",
                    "required": [
                        "type",
                        "messages",
                        "case_sensitive"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "MatchesExactMessage",
                            "default": "MatchesExactMessage",
                            "options": {
                                "hidden": true
                            }
                        },
                        "case_sensitive": {
                            "type": "boolean",
                            "format": "checkbox",
                            "title": "Case sensitive",
                            "default": false
                        },
                        "messages": {
                            "type": "array",
                            "title": "Texts",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Text",
                                "maxLength": 1000
                            },
                            "maxItems": 10000
                        }
                    },
                    "options": {
                        "summary": "{messages|n} texts · {case_sensitive?case-sensitive:any case}",
                        "phrase": "exactly matches one of {messages|n} texts"
                    }
                },
                {
                    "type": "object",
                    "title": "💬 Message Matches Any of These Regex Patterns",
                    "description": "Matches when the message matches any of the given regular expressions (Rust `regex` crate syntax — no lookaheads/lookbehinds/backreferences). Runs against the raw, unmodified message text — unlike `Message Contains Any of These Words`, it does **not** see through leet-speak, look-alike characters, or other obfuscation. Use it for structural patterns (e.g. \"`\\d{4,}`\" for runs of 4+ digits, \"` {5,}`\" for 5+ consecutive spaces) rather than for words. _Build and test your patterns at [🧪 regex101](https://regex101.com/) — pick **Rust** in the flavor list on the left, so it behaves exactly like this bot._",
                    "required": [
                        "type",
                        "patterns"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "MatchesRegex",
                            "default": "MatchesRegex",
                            "options": {
                                "hidden": true
                            }
                        },
                        "patterns": {
                            "type": "array",
                            "title": "Regex Patterns",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Pattern",
                                "maxLength": 200
                            },
                            "maxItems": 100
                        }
                    },
                    "options": {
                        "summary": "{patterns|n} patterns",
                        "phrase": "matches a regex pattern"
                    }
                },
                {
                    "type": "object",
                    "title": "💬 Message Contains Repeated Sequence",
                    "description": "Matches when some sequence of characters is repeated back-to-back at least the given number of times — e.g. `aaaaa`, `!!!!!`, `hahahahaha`, `buy now buy now buy now`. Sequences can be up to 50 characters long; letter case is ignored, and spaces, line breaks and emoji count as characters. Note that numbers like `1000000` and dots like `.....` count too.",
                    "required": [
                        "type",
                        "min_repeats",
                        "min_length"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ContainsRepeatedSequence",
                            "default": "ContainsRepeatedSequence",
                            "options": {
                                "hidden": true
                            }
                        },
                        "min_repeats": {
                            "type": "integer",
                            "title": "Minimum Repeats in a Row",
                            "description": "Matches if a sequence appears at least this many times in a row. For example, 5 catches `aaaaa` but not `aaaa`.",
                            "minimum": 2,
                            "default": 5
                        },
                        "min_length": {
                            "type": "integer",
                            "title": "Minimum Sequence Length",
                            "description": "Shortest sequence (in characters) that counts. 1 catches single repeated characters like `!!!!!`; raise it to ignore them — e.g. with 2 and Minimum Repeats 2, the doubled letter in `keep` is fine but `byebye` is not.",
                            "minimum": 1,
                            "maximum": 50,
                            "default": 1
                        }
                    },
                    "options": {
                        "summary": "≥{min_repeats}× of ≥{min_length} chars",
                        "phrase": "contains a repeated sequence"
                    }
                },
                {
                    "type": "object",
                    "title": "🔗 Message Contains a Link to Any of These Websites",
                    "description": "Matches when the message contains a link to one of the listed websites or domains (including obfuscated links like `spam [dot] com` or `hxxp://`).",
                    "required": [
                        "type",
                        "domains"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ContainsLinksInList",
                            "default": "ContainsLinksInList",
                            "options": {
                                "hidden": true
                            }
                        },
                        "domains": {
                            "type": "array",
                            "title": "Websites",
                            "description": "Websites or domains to match (e.g., `spam.com`). You can list an entire domain (e.g., `example.com` also matches `sub.example.com`) or only a specific subdomain (e.g., `sub.example.com` matches `sub.example.com` but not `example.com`). Do not include `http://` or `https://`, just type the domain name.",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Domain",
                                "maxLength": 100
                            },
                            "maxItems": 10000
                        }
                    },
                    "options": {
                        "summary": "{domains|list}",
                        "phrase": "contains a link to a listed website"
                    }
                },
                {
                    "type": "object",
                    "title": "🔗 Message Contains a Link to a Website Outside This List",
                    "description": "Matches when the message contains a link to a website that is NOT in the list (including obfuscated links like `spam [dot] com` or `hxxp://`). Leave the list empty to match ALL links.",
                    "required": [
                        "type",
                        "domains"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ContainsLinksOutsideList",
                            "default": "ContainsLinksOutsideList",
                            "options": {
                                "hidden": true
                            }
                        },
                        "domains": {
                            "type": "array",
                            "title": "Websites",
                            "description": "Websites that do not trigger this condition (e.g., `simplex.chat`). You can list an entire domain (e.g., `example.com` covers `sub.example.com` and `example.com`) or only a specific subdomain (e.g., `sub.example.com` covers `sub.example.com` but not `example.com`). Do not include `http://` or `https://`, just type the domain name. Leave the list empty to match ALL links.",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Domain"
                            }
                        }
                    },
                    "options": {
                        "summary": "outside {domains|n} domains",
                        "phrase": "contains a link to a website outside the list"
                    }
                },
                {
                    "type": "object",
                    "title": "🔗 Message Contains a Link Outside Top 100 Websites",
                    "description": "Matches when the message contains a link to a website that is neither in the built-in list of the top 100 websites (**Google**, **GitHub**, **Wikipedia**, **YouTube**, **Reddit**, etc.) nor in your extra list (including obfuscated links like `spam [dot] com` or `hxxp://`).",
                    "required": [
                        "type",
                        "domains"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ContainsLinksOutsideTop100",
                            "default": "ContainsLinksOutsideTop100",
                            "options": {
                                "hidden": true
                            }
                        },
                        "domains": {
                            "type": "array",
                            "title": "Extra Websites Added to Top 100",
                            "description": "Websites treated as if they were in the top 100 list. Do not include `http://` or `https://`, just type the domain name.",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Domain"
                            }
                        }
                    },
                    "options": {
                        "summary": "top 100 + {domains|n} extra",
                        "phrase": "contains a link outside the top 100 websites"
                    }
                },
                {
                    "type": "object",
                    "title": "📏 Message Is Empty or Blank",
                    "description": "Matches when the message consists only of whitespace, line breaks, or invisible/special characters.",
                    "required": [
                        "type"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "IsBlank",
                            "default": "IsBlank",
                            "options": {
                                "hidden": true
                            }
                        }
                    },
                    "options": {
                        "phrase": "is empty or blank"
                    }
                },
                {
                    "type": "object",
                    "title": "📏 Message Contains Invisible Characters",
                    "description": "Matches any message that contains even a single invisible or formatting character (e.g. zero-width spaces, Braille blank pattern, bidi overrides, variation selectors), even if the message also has regular text. Emoji that are joined into one (like 👨‍👩‍👧) do not count.",
                    "required": [
                        "type"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ContainsInvisibleCharacters",
                            "default": "ContainsInvisibleCharacters",
                            "options": {
                                "hidden": true
                            }
                        }
                    },
                    "options": {
                        "phrase": "contains invisible characters"
                    }
                },
                {
                    "type": "object",
                    "title": "📏 Message Exceeds Max Characters",
                    "description": "Matches when the message is longer than the given number of characters.",
                    "required": [
                        "type",
                        "max_characters"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ExceedsMaxCharacters",
                            "default": "ExceedsMaxCharacters",
                            "options": {
                                "hidden": true
                            }
                        },
                        "max_characters": {
                            "type": "integer",
                            "title": "Max Characters",
                            "description": "Matches if the message has more than this number of characters. Spaces and line breaks count too.",
                            "minimum": 1,
                            "default": 1000
                        }
                    },
                    "options": {
                        "summary": "> {max_characters} chars",
                        "phrase": "has more than {max_characters} characters"
                    }
                },
                {
                    "type": "object",
                    "title": "📏 Message Exceeds Max Words",
                    "description": "Matches when the message has more than the given number of words.",
                    "required": [
                        "type",
                        "max_words"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ExceedsMaxWords",
                            "default": "ExceedsMaxWords",
                            "options": {
                                "hidden": true
                            }
                        },
                        "max_words": {
                            "type": "integer",
                            "title": "Max Words",
                            "description": "Matches if the message has more than this number of words (separated by spaces or line breaks).",
                            "minimum": 1,
                            "default": 150
                        }
                    },
                    "options": {
                        "summary": "> {max_words} words",
                        "phrase": "has more than {max_words} words"
                    }
                },
                {
                    "type": "object",
                    "title": "📏 Message Exceeds Max Lines",
                    "description": "Matches when the message takes more than the given number of lines on screen — for example a message flooding the chat with line breaks.",
                    "required": [
                        "type",
                        "max_lines",
                        "chars_per_line"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ExceedsMaxLines",
                            "default": "ExceedsMaxLines",
                            "options": {
                                "hidden": true
                            }
                        },
                        "max_lines": {
                            "type": "integer",
                            "title": "Max Lines",
                            "description": "Matches if the message takes more than this number of lines. See 'Characters per Line' below for how long lines are counted.",
                            "minimum": 1,
                            "default": 10
                        },
                        "chars_per_line": {
                            "type": "integer",
                            "title": "Characters per Line (Screen Wrap)",
                            "description": "If not 0, every line longer than this number of characters counts as several lines, the way it wraps on a phone screen: with 40, a single line of 100 characters counts as 3 lines. With 0, only actual line breaks count. About 40 characters fit on one line on a mobile screen.",
                            "minimum": 0,
                            "default": 40
                        }
                    },
                    "options": {
                        "summary": "> {max_lines} lines @ {chars_per_line} cpl",
                        "phrase": "has more than {max_lines} lines"
                    }
                },
                {
                    "type": "object",
                    "title": "👤 Author Hits Message Rate Limit",
                    "description": "Matches when the author sends at least the given number of messages within the time window, this one included.",
                    "required": [
                        "type",
                        "message_count",
                        "time_window_minutes"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "AuthorHitsMessageRateLimit",
                            "default": "AuthorHitsMessageRateLimit",
                            "options": {
                                "hidden": true
                            }
                        },
                        "message_count": {
                            "type": "integer",
                            "title": "Number of Messages",
                            "description": "Matches when the author's messages in the time window, this one included, reach this number.",
                            "minimum": 1,
                            "default": 5
                        },
                        "time_window_minutes": {
                            "type": "integer",
                            "title": "Time Window (Minutes)",
                            "description": "The time window in minutes over which the messages accumulate (maximum 60 minutes).",
                            "minimum": 1,
                            "maximum": 60,
                            "default": 1
                        }
                    },
                    "options": {
                        "summary": "{message_count} msg / {time_window_minutes} min",
                        "phrase": "author sent at least {message_count} messages in {time_window_minutes} min"
                    }
                },
                {
                    "type": "object",
                    "title": "👤 Author Hits Moderation Rate Limit",
                    "description": "Matches when at least the given number of the author's messages were moderated by the bot within the time window. The current message counts too if another rule moderates it.",
                    "required": [
                        "type",
                        "message_count",
                        "time_window_minutes"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "AuthorHitsModerationRateLimit",
                            "default": "AuthorHitsModerationRateLimit",
                            "options": {
                                "hidden": true
                            }
                        },
                        "message_count": {
                            "type": "integer",
                            "title": "Number of Moderated Messages",
                            "description": "Matches when the number of the author's messages moderated by the bot in the time window reaches this number.",
                            "minimum": 1,
                            "default": 3
                        },
                        "time_window_minutes": {
                            "type": "integer",
                            "title": "Time Window (Minutes)",
                            "description": "The time window in minutes over which the moderated messages accumulate (maximum 60 minutes).",
                            "minimum": 1,
                            "maximum": 60,
                            "default": 60
                        }
                    },
                    "options": {
                        "summary": "{message_count} moderated / {time_window_minutes} min",
                        "phrase": "author had at least {message_count} messages moderated in {time_window_minutes} min"
                    }
                },
                {
                    "type": "object",
                    "title": "👤 Author Joined Recently",
                    "description": "Matches when the author joined the group less than the given number of minutes ago. On its own it moderates every message from newcomers; combine it with another condition inside **All of These Conditions Match (AND)** to only restrict what newcomers post, e.g. links. Only members who joined **after the bot** was added have a known join time — members who were already in the group before that never match.",
                    "required": [
                        "type",
                        "time_window_minutes"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "AuthorJoinedRecently",
                            "default": "AuthorJoinedRecently",
                            "options": {
                                "hidden": true
                            }
                        },
                        "time_window_minutes": {
                            "type": "integer",
                            "title": "Joined Less Than (Minutes) Ago",
                            "description": "Matches if the author joined the group less than this many minutes before sending the message. For example, 60 matches members during their first hour in the group.",
                            "minimum": 1,
                            "default": 60
                        }
                    },
                    "options": {
                        "summary": "< {time_window_minutes} min ago",
                        "phrase": "author joined less than {time_window_minutes} min ago"
                    }
                },
                {
                    "type": "object",
                    "title": "🧩 All of These Conditions Match (AND)",
                    "description": "Matches only when **every** condition inside it matches. Use it to narrow a broad condition down, for example a listed word **and** an author who just joined. An empty list is not a valid condition — add at least one condition inside, or remove this one.",
                    "required": [
                        "type",
                        "conditions"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "All",
                            "default": "All",
                            "options": {
                                "hidden": true
                            }
                        },
                        "conditions": {
                            "type": "array",
                            "title": "Conditions (all must match)",
                            "options": {
                                "disable_collapse": true
                            },
                            "minItems": 1,
                            "items": {
                                "$ref": "#/definitions/condition"
                            }
                        }
                    },
                    "options": {
                        "summary": "{conditions|n} conditions",
                        "phrase": "all of ({conditions|phrases})"
                    }
                },
                {
                    "type": "object",
                    "title": "🔀 Any of These Conditions Match (OR)",
                    "description": "Matches when **at least one** condition inside it matches. Note that separate rules already work this way, so you only need this inside another condition — for example _(spam word **or** spam link) **and** a new author_.",
                    "required": [
                        "type",
                        "conditions"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "Any",
                            "default": "Any",
                            "options": {
                                "hidden": true
                            }
                        },
                        "conditions": {
                            "type": "array",
                            "title": "Conditions (any may match)",
                            "options": {
                                "disable_collapse": true
                            },
                            "minItems": 1,
                            "items": {
                                "$ref": "#/definitions/condition"
                            }
                        }
                    },
                    "options": {
                        "summary": "{conditions|n} conditions",
                        "phrase": "any of ({conditions|phrases})"
                    }
                },
                {
                    "type": "object",
                    "title": "✖️ This Condition Does Not Match (NOT)",
                    "description": "Matches when the condition inside it does **not** match. Careful with conditions that already contain a negation (`… Outside This List`, `… Outside Top 100 Websites`), because the result is a double negative that is hard to read. `Author Hits Moderation Rate Limit` cannot be used inside this one.",
                    "required": [
                        "type",
                        "condition"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "Not",
                            "default": "Not",
                            "options": {
                                "hidden": true
                            }
                        },
                        "condition": {
                            "$ref": "#/definitions/condition"
                        }
                    },
                    "options": {
                        "phrase": "not ({condition|phrase})"
                    }
                }
            ]
        }
    },
    "type": "array",
