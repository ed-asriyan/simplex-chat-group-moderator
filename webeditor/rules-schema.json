{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Moderation Rules",
    "description": "**1️⃣ Click the gray button above to add a rule. 2️⃣ For each rule set the ⚡ Action — what the bot does when a message matches — and the 🔎 Condition — what to detect. 3️⃣ When you're done, click the red \"Apply Changes\" button above and send the copied link back to the bot.**",
    "definitions": {
        "action": {
            "type": "object",
            "title": "⚡ Action",
            "description": "What the bot does when a message matches this rule.",
            "options": {
                "disable_collapse": true
            },
            "oneOf": [
                {
                    "type": "object",
                    "title": "🗑 Moderate the message",
                    "description": "Marks the message as moderated. The bot must have the **Moderator or higher** role in the group to perform this action.",
                    "required": [
                        "type"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ModerateMessage",
                            "default": "ModerateMessage",
                            "options": {
                                "hidden": true
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "title": "🚪 Kick the author",
                    "description": "Kicks the author from the group. The bot must have the **Owner** role in the group to perform this action.",
                    "required": [
                        "type",
                        "delete_messages"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "KickAuthor",
                            "default": "KickAuthor",
                            "options": {
                                "hidden": true
                            }
                        },
                        "delete_messages": {
                            "type": "string",
                            "title": "Author's messages",
                            "enum": [
                                "None",
                                "TriggeredMessage",
                                "AllMessages"
                            ],
                            "enum_titles": [
                                "Don't delete any messages",
                                "Moderate the message that triggered the rule",
                                "Delete ALL messages the author has sent in this group"
                            ],
                            "options": {
                                "enum_titles": [
                                    "Don't delete any messages",
                                    "Moderate the message that triggered the rule",
                                    "Delete ALL messages the author has sent in this group"
                                ]
                            },
                            "default": "TriggeredMessage"
                        }
                    }
                },
                {
                    "type": "object",
                    "title": "👁 Set author as observer",
                    "description": "Sets the author to the observer role. The bot must have the **Admin or higher** role in the group to perform this action.",
                    "required": [
                        "type",
                        "delete_message"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "SetAuthorObserver",
                            "default": "SetAuthorObserver",
                            "options": {
                                "hidden": true
                            }
                        },
                        "delete_message": {
                            "type": "string",
                            "title": "Author's message",
                            "enum": [
                                "None",
                                "TriggeredMessage"
                            ],
                            "enum_titles": [
                                "Don't delete any messages",
                                "Moderate the message that triggered the rule"
                            ],
                            "options": {
                                "enum_titles": [
                                    "Don't delete any messages",
                                    "Moderate the message that triggered the rule"
                                ]
                            },
                            "default": "TriggeredMessage"
                        }
                    }
                }
            ]
        },
        "condition": {
            "type": "object",
            "title": "🔎 Condition",
            "description": "What the bot looks for in a message.",
            "options": {
                "disable_collapse": true
            },
            "oneOf": [
                {
                    "type": "object",
                    "title": "🚫 Message Contains Banned Words",
                    "description": "Matches when the message contains specified banned words or phrases. It automatically catches different capitalizations and common tricks used to obfuscate words (like writing `b@dw0rd` instead of `badword`). _List of ready-to-use bad words: [🔞 List of Dirty, Naughty, Obscene Words](https://github.com/LDNOOBW/List-of-Dirty-Naughty-Obscene-and-Otherwise-Bad-Words), [☕ Google Profanity Words](https://github.com/coffee-and-fun/google-profanity-words/tree/main/data), [💬 Comment Blocklist](https://github.com/splorp/wordpress-comment-blocklist)_",
                    "required": [
                        "type",
                        "keywords"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ContainsBannedWords",
                            "default": "ContainsBannedWords",
                            "options": {
                                "hidden": true
                            }
                        },
                        "keywords": {
                            "type": "array",
                            "title": "Banned Words / Phrases",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Word/Phrase",
                                "maxLength": 100
                            },
                            "maxItems": 10000
                        }
                    }
                },
                {
                    "type": "object",
                    "title": "🚫 Message Matches Exact Text",
                    "description": "Matches when the message text exactly matches one of the specified messages.",
                    "required": [
                        "type",
                        "messages",
                        "case_sensitive"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "MatchesExactMessage",
                            "default": "MatchesExactMessage",
                            "options": {
                                "hidden": true
                            }
                        },
                        "case_sensitive": {
                            "type": "boolean",
                            "format": "checkbox",
                            "title": "Case sensitive",
                            "default": false
                        },
                        "messages": {
                            "type": "array",
                            "title": "Forbidden Exact Messages",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Message",
                                "maxLength": 1000
                            },
                            "maxItems": 10000
                        }
                    }
                },
                {
                    "type": "object",
                    "title": "🚫 Message Contains Links to Forbidden Websites",
                    "description": "Matches when the message contains links to specified forbidden websites or domains (including obfuscated links like `spam [dot] com` or `hxxp://`).",
                    "required": [
                        "type",
                        "blocked"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ContainsLinksToForbiddenWebsites",
                            "default": "ContainsLinksToForbiddenWebsites",
                            "options": {
                                "hidden": true
                            }
                        },
                        "blocked": {
                            "type": "array",
                            "title": "Forbidden Websites",
                            "description": "Specific websites or domains to match (e.g., `spam.com`). You can specify entire domains (e.g., `example.com` will match `sub.example.com`) or only specific subdomains (e.g., `sub.example.com` will match `sub.example.com` but not `example.com`). Do not include `http://` or `https://`, just type the domain name.",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Domain",
                                "maxLength": 100
                            },
                            "maxItems": 10000
                        }
                    }
                },
                {
                    "type": "object",
                    "title": "✅ Message Contains Links Outside Approved Websites",
                    "description": "Matches when the message contains links to websites that are NOT on the approved list (including obfuscated links like `spam [dot] com` or `hxxp://`). Leave the list empty to match ALL links.",
                    "required": [
                        "type",
                        "allowed"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ContainsLinksOutsideAllowedList",
                            "default": "ContainsLinksOutsideAllowedList",
                            "options": {
                                "hidden": true
                            }
                        },
                        "allowed": {
                            "type": "array",
                            "title": "Approved Websites",
                            "description": "Domains permitted in messages (e.g., `simplex.chat`). You can allow an entire domain (e.g., `example.com` will allow `sub.example.com` and `example.com`) or allow only a specific subdomain (e.g., `sub.example.com` will allow `sub.example.com` but not `example.com`). Do not include `http://` or `https://`, just type the domain name. Leave the list empty to match ALL links.",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Domain"
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "title": "✅ Message Contains Links Outside Top 100 Safe Websites",
                    "description": "Matches when the message contains links to websites other than the built-in top 100 well-known safe sites (**Google**, **GitHub**, **Wikipedia**, **YouTube**, **Reddit**, etc.) and any additional approved websites (even obfuscated links like `spam [dot] com` or `hxxp://`).",
                    "required": [
                        "type",
                        "allowed"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "ContainsLinksOutsideTop100",
                            "default": "ContainsLinksOutsideTop100",
                            "options": {
                                "hidden": true
                            }
                        },
                        "allowed": {
                            "type": "array",
                            "title": "Additional Approved Websites",
                            "description": "Add any additional permitted domains. Do not include `http://` or `https://`, just type the domain name.",
                            "options": {
                                "disable_collapse": true
                            },
                            "items": {
                                "type": "string",
                                "title": "Domain"
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "title": "🚫 Message Floods Chat or Exceeds Limits",
                    "description": "Matches when the message is blank, excessively long, contains invisible characters, or floods the chat with too many lines or words. By default, it matches all empty/invisible messages. You can optionally limit the maximum characters, words, or lines (with custom characters-per-line soft wrapping), or strictly forbid any hidden/invisible characters.",
                    "required": [
                        "type",
                        "max_characters",
                        "max_words",
                        "max_lines",
                        "chars_per_line",
                        "disallow_empty_messages",
                        "disallow_invisible_chars"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "FloodsChatOrExceedsLimits",
                            "default": "FloodsChatOrExceedsLimits",
                            "options": {
                                "hidden": true
                            }
                        },
                        "max_characters": {
                            "type": "integer",
                            "title": "Max Characters",
                            "description": "Matches if the message exceeds this number of characters (0 to disable).",
                            "minimum": 0,
                            "default": 0
                        },
                        "max_words": {
                            "type": "integer",
                            "title": "Max Words",
                            "description": "Matches if the message exceeds this number of words (0 to disable).",
                            "minimum": 0,
                            "default": 0
                        },
                        "max_lines": {
                            "type": "integer",
                            "title": "Max Lines",
                            "description": "Matches if the message exceeds this number of lines (0 to disable). Line wrapping is calculated using 'Characters per Line' below.",
                            "minimum": 0,
                            "default": 0
                        },
                        "chars_per_line": {
                            "type": "integer",
                            "title": "Characters per Line (Screen Wrap)",
                            "description": "Number of characters that fit into one line on mobile screens (default: 40, 0 to disable wrapping). A long line of text without newlines will be counted as multiple lines according to this width.",
                            "minimum": 0,
                            "default": 40
                        },
                        "disallow_empty_messages": {
                            "type": "boolean",
                            "format": "checkbox",
                            "title": "Message is Empty or Blank",
                            "description": "If enabled, matches messages that consist only of whitespace, line breaks, or invisible/special characters.",
                            "default": true
                        },
                        "disallow_invisible_chars": {
                            "type": "boolean",
                            "format": "checkbox",
                            "title": "Message Contains Invisible Characters",
                            "description": "If enabled, matches any message that contains even a single invisible or formatting character (e.g. zero-width spaces, Braille blank pattern, bidi overrides, variation selectors), even if the message also has regular text.",
                            "default": false
                        }
                    }
                },
                {
                    "type": "object",
                    "title": "🚫 User Exceeds Messages Rate Limit",
                    "description": "Matches when a user sends a specified number of messages within a given time window (in minutes).",
                    "required": [
                        "type",
                        "message_count",
                        "time_window_minutes"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "UserExceedsMessagesRateLimit",
                            "default": "UserExceedsMessagesRateLimit",
                            "options": {
                                "hidden": true
                            }
                        },
                        "message_count": {
                            "type": "integer",
                            "title": "Number of Messages",
                            "description": "Matches when the user reaches or exceeds this number of messages in the time window.",
                            "minimum": 1,
                            "default": 5
                        },
                        "time_window_minutes": {
                            "type": "integer",
                            "title": "Time Window (Minutes)",
                            "description": "The time window in minutes over which the messages accumulate (maximum 60 minutes).",
                            "minimum": 1,
                            "maximum": 60,
                            "default": 1
                        }
                    }
                }
            ]
        }
    },
    "type": "array",
    "format": "tabs",
    "options": {
        "disable_collapse": true
    },
    "items": {
        "type": "object",
        "title": "Rule",
        "headerTemplate": "{{ i1 }}. {{ self.condition.type }}",
        "required": [
            "action",
            "condition"
        ],
        "additionalProperties": false,
        "options": {
            "disable_collapse": true
        },
        "properties": {
            "action": {
                "$ref": "#/definitions/action"
            },
            "condition": {
                "$ref": "#/definitions/condition"
            }
        }
    }
}